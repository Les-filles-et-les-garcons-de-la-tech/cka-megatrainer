#cloud-config
hostname: {{ vm.name }}
fqdn: {{ vm.name }}.{{ vm_network }}.local
manage_etc_hosts: false
users:
  - name: ubuntu
    groups: [sudo]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys:
      - {{ ssh_pubkey }}
ssh_pwauth: false
growpart: {mode: auto, devices: ["/"]}
