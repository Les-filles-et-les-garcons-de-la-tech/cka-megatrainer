# Generated by iaac/vm/host.yml (CKA lab): `ssh -F iaac/vm/.ssh/config cp1`
{% for vm in vms %}
Host {{ vm.name }}
  HostName {{ vm_net_prefix }}.{{ vm.ip }}
  User ubuntu
  IdentityFile {{ playbook_dir }}/.ssh/id_ed25519
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  LogLevel ERROR
{% endfor %}
